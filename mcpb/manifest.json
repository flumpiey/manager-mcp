{
  "manifest_version": "0.3",
  "name": "manager-mcp",
  "version": "0.1.0",
  "description": "MCP server for self-hosted Manager.io bookkeeping (read-only by default).",
  "author": {
    "name": "flumpiey",
    "url": "https://github.com/flumpiey/manager-mcp"
  },
  "homepage": "https://github.com/flumpiey/manager-mcp",
  "documentation": "https://github.com/flumpiey/manager-mcp#readme",
  "support": "https://github.com/flumpiey/manager-mcp/issues",
  "icon": "icon.png",
  "server": {
    "type": "python",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/flumpiey/manager-mcp",
        "manager-mcp"
      ],
      "env": {
        "MANAGER_API_URL": "${user_config.api_url}",
        "MANAGER_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_url": {
      "type": "string",
      "title": "Manager API URL",
      "description": "Instance root including /api2 when required (e.g. http://127.0.0.1:55667/api2).",
      "required": true,
      "default": "http://127.0.0.1:55667/api2"
    },
    "api_key": {
      "type": "string",
      "title": "Manager API key",
      "description": "Access token from Manager Settings → Access Tokens (sent as X-API-KEY).",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.10,<4.0"
    }
  }
}
