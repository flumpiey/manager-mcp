# Manager.io instance (opaque base URL; include /api2 when required)
MANAGER_API_URL=http://127.0.0.1:55667/api2
MANAGER_API_KEY=your-access-token-here

# Opt-in writes (off by default). Only these truthy values enable api_write:
# 1, true, yes, on (case-insensitive). Unset/empty/other → read-only.
# MANAGER_MCP_ALLOW_WRITES=1
